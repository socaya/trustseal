# Flask
FLASK_ENV=development
FLASK_DEBUG=1
LOGGING_LEVEL=DEBUG
SECRET_KEY=replace-with-a-random-secret

# JWT
JWT_SECRET_KEY=replace-with-a-different-random-secret
JWT_ACCESS_TOKEN_EXPIRES=300

# Database
DATABASE_URL=postgresql://trustseal:replace-me@localhost/trustseal
SQLALCHEMY_TRACK_MODIFICATIONS=false

# Email
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
DEFAULT_MAIL_SENDER=TrustSeal <noreply@example.com>

# Internal API
SYSTEM_API_TOKEN=replace-with-a-random-token
API_BASE_URL=http://127.0.0.1:5000/api


# Private, scanned PDF ingress (requires private directory mode 0700)
# NEVER place this directory under app/static, a CDN, or the web-server root.
PRIVATE_DOCUMENT_ROOT=/var/lib/trustseal/private-objects
DOCUMENT_CLAMSCAN_BINARY=/usr/bin/clamscan
DOCUMENT_SCAN_TIMEOUT=30


# Certificate-backed TrustSeal platform PDF seal (not individual signer PKI).
# All paths must be absolute; keys must not be checked into the repository.
PDF_PLATFORM_PKCS12=/etc/trustseal/keys/platform-seal.p12
PDF_PLATFORM_PKCS12_PASSWORD=
PDF_TRUST_ROOT_PEM=/etc/trustseal/trust/approved-root-ca.pem
# Active same-tenant administrator; must be independent of author/participants.
PDF_SEAL_OPERATOR_ID=
PDF_FINALIZATION_ENABLED=false

# Anonymous caller-uploaded platform PDF verification. Do not enable without
# ingress rate limiting, worker sandboxing and approved trust configuration.
PUBLIC_PDF_VERIFICATION_ENABLED=false
PUBLIC_PDF_VERIFICATION_CERT_SHA256=

# Governed stamp authority: disabled until operator/keys are configured and
# approval, integrity and certificate verification pass staging.
STAMP_ATTESTATION_ENABLED=false
STAMP_ATTESTATION_PRIVATE_KEY=
STAMP_ATTESTATION_PUBLIC_KEY=
STAMP_ATTESTATION_TRUSTED_KEYS_JSON=
STAMP_ATTESTATION_OPERATOR_ID=

# Gated visible PDF stamp derivative; also requires PDF_FINALIZATION_ENABLED=true.
STAMP_PDF_RENDER_ENABLED=false

# Signed evidence integrity checkpoints are disabled until operator/key custody is configured.
EVIDENCE_CHECKPOINT_ENABLED=false
EVIDENCE_CHECKPOINT_PRIVATE_KEY=
EVIDENCE_CHECKPOINT_PUBLIC_KEY=
EVIDENCE_CHECKPOINT_TRUSTED_KEYS_JSON=
EVIDENCE_CHECKPOINT_OPERATOR_ID=

# RFC 3161 detached timestamps. Explicitly opt in only with approved TSA trust.
RFC3161_ENABLED=false
RFC3161_TSA_URL=
RFC3161_TSA_CERT_PEM=
RFC3161_TRUST_ROOT_PEM=
RFC3161_OPENSSL_BINARY=openssl

# Operator-supplied signed TSA issuer CRL; off until issuer trust is approved.
CRL_EVIDENCE_ENABLED=false
CRL_EVIDENCE_DER=
CRL_ISSUER_CERT_PEM=

# Verified issuer-signed OCSP response; disabled until approved responder evidence is supplied.
OCSP_EVIDENCE_ENABLED=false
OCSP_EVIDENCE_DER=
OCSP_ISSUER_CERT_PEM=

# Partial PKIX validation dossier; requires operator-reviewed revocation evidence.
VALIDATION_DOSSIER_ENABLED=false
# Optional pinned PEM intermediate CA certificate paths in leaf-to-root order.
VALIDATION_TSA_INTERMEDIATES_JSON=[]

# Optional CRL file paths for each non-root TSA chain position (leaf first).
# Use null for missing evidence; must align with explicit TSA chain order.
# Example: ["/etc/trustseal/revocation/tsa-issuer.crl","/etc/trustseal/revocation/intermediate-issuer.crl"]
VALIDATION_CHAIN_CRL_PATHS_JSON=

# Operator-controlled, separate validation-material PDF derivative (not PAdES-LT).
PDF_DSS_DERIVATIVE_ENABLED=false
